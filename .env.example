# Copie este arquivo para .env.local para rodar localmente (npm run dev).
# Na Vercel, essas mesmas chaves vao em: Project -> Settings -> Environment Variables.

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Usadas apenas pelas funcoes serverless em /api (NAO levam prefixo VITE_)
OPENAI_API_KEY=
ASAAS_API_KEY=
